# Supabase 연결 정보 (Vite는 VITE_ 접두사 변수만 클라이언트에 노출)
# 실제 값은 Supabase 대시보드 > Project Settings > API 에서 복사
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# GA4 측정 ID (Google Analytics > 관리 > 데이터 스트림 > 웹). 없으면 추적 안 함.
# 로컬 dev에서는 값이 있어도 보내지 않음. 실제 값은 Vercel 환경변수에만.
VITE_GA_ID=G-XXXXXXXXXX
